{
  "name": "chinga-safety-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend", "shared"],
  "scripts": {
    "dev": "concurrently -n web,api -c green,yellow \"npm:dev -w frontend\" \"npm:dev -w backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend && npm run lint -w backend",
    "test": "npm run test -w backend && node --test scripts/service-worker.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
